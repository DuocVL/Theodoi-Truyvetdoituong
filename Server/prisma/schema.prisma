generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, vector]
}

enum AccountType {
  USER
  SUBJECT
}

model Account {
  id         String      @id @default(uuid())
  type       AccountType
  username   String      @unique
  password   String
  status     String      @default("ACTIVE")
  created_at DateTime    @default(now())

  user    User?
  subject Subject?

  refreshToken RefreshToken[]
  devices      Device[]

  @@map("accounts")
}

model User {
  id         String  @id @default(uuid())
  account_id String  @unique
  full_name  String
  email      String?
  status     Boolean @default(true)

  created_at DateTime @default(now())
  update_at  DateTime @updatedAt

  account Account @relation(fields: [account_id], references: [id])

  alerts    Alert[]     @relation("ResolvedAlerts")
  subject   Subject[]   @relation("UserToSubject")
  auditLogs SystemLog[] @relation("UserToSystemLog")
  zone      Zone[]      @relation("UserToZone")
  userRole  UserRole[]  @relation("UserToUserRole")

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  userRole    UserRole[] @relation("RoleToUserRole")

  @@map("roles")
}

model UserRole {
  user_id String
  role_id Int
  role    Role   @relation("RoleToUserRole", fields: [role_id], references: [id], onDelete: Cascade)
  user    User   @relation("UserToUserRole", fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model Subject {
  id         String @id @default(uuid())
  account_id String @unique

  code      String    @unique @default(uuid())
  full_name String
  dob       DateTime?
  gender    String?
  id_number String?
  address   String?
  phone     String?

  status           String    @default("ACTIVE")
  monitoring_start DateTime?
  monitoring_end   DateTime?

  created_by String
  created_at DateTime @default(now())
  update_at  DateTime @updatedAt
  deleted_at DateTime

  creator User    @relation("UserToSubject", fields: [created_by], references: [id])
  account Account @relation(fields: [account_id], references: [id])

  alert    Alert[]    @relation("SubjectToAlert")
  checkin  Checkin[]  @relation("SubjectToCheckin")
  events   EventLog[] @relation("SubjectToEventLog")
  faceData FaceData[] @relation("SubjectToFaceData")

  subjectZone SubjectZone[] @relation("SubjectToSubjectZone")

  @@index([full_name])
  @@index([status])
  @@index([created_by])
  @@map("subjects")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_hash String   @unique
  account_id String
  device_id  String
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("refreshtokens")
}

model Device {
  id           String    @id @default(uuid())
  account_id   String
  device_token String?
  device_uuid  String
  platform     String
  app_version  String?
  is_active    Boolean   @default(true)
  is_trusted   Boolean   @default(true)
  last_seen_at DateTime?
  created_at   DateTime  @default(now())
  account      Account?  @relation(fields: [account_id], references: [id])

  @@unique([account_id, device_uuid])
  @@map("devices")
}

model FaceData {
  id         String                @id @default(uuid())
  subject_id String
  embedding  Unsupported("vector")
  image_url  String
  status  String 
  created_at DateTime              @default(now())
  update_at  DateTime              @updatedAt
  subject    Subject               @relation("SubjectToFaceData", fields: [subject_id], references: [id], onDelete: Cascade)

  @@map("face_data")
}

model Zone {
  id          String                   @id @default(uuid())
  zone_name   String
  geom        Unsupported("geography")
  description String?
  created_by  String
  is_active   Boolean                  @default(true)
  created_at  DateTime                 @default(now())
  update_at   DateTime                 @updatedAt
  subjectZone SubjectZone[]            @relation("ZoneToSubjectZone")
  creator     User                     @relation("UserToZone", fields: [created_by], references: [id])

  @@index([geom], type: Gist)
  @@map("zones")
}

model SubjectZone {
  subject_id       String
  zone_id          String
  interval_minutes Int      @default(15)
  created_at       DateTime @default(now())
  subject          Subject  @relation("SubjectToSubjectZone", fields: [subject_id], references: [id], onDelete: Cascade)
  zone             Zone     @relation("ZoneToSubjectZone", fields: [zone_id], references: [id], onDelete: Cascade)

  @@id([subject_id, zone_id])
  @@map("subject_zones")
}

model Checkin {
  id            BigInt                   @id @default(autoincrement())
  subject_id    String
  location      Unsupported("geography")
  image_url     String?
  face_verified Boolean                  @default(false)
  confidence    Float
  status        String                   @default("ON_TIME")
  checkin_time  DateTime                 @default(now())
  subject       Subject                  @relation("SubjectToCheckin", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([subject_id, checkin_time])
  @@map("checkins")
}

model Alert {
  id          String                    @id @default(uuid())
  subject_id  String
  type        String
  severity    Int
  message     String
  location    Unsupported("geography")?
  status      String                    @default("PENDING")
  resolved_by String?
  resolved_at DateTime?
  created_at  DateTime                  @default(now())
  resolver    User?                     @relation("ResolvedAlerts", fields: [resolved_by], references: [id])
  subject     Subject                   @relation("SubjectToAlert", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([subject_id, status])
  @@index([created_at(sort: Desc)])
  @@map("alerts")
}

model EventLog {
  id          BigInt   @id @default(autoincrement())
  subject_id  String
  event_type  String
  description String
  created_at  DateTime @default(now())
  subject     Subject  @relation("SubjectToEventLog", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([subject_id, created_at])
  @@map("event_logs")
}

model SystemLog {
  id        BigInt  @id @default(autoincrement())
  user_id   String?
  action    String
  entity    String? // bảng bị tác động (Subject, Account,...)
  entity_id String?

  old_data Json? // dữ liệu trước
  new_data Json? // dữ liệu sau

  ip_address String?
  user_agent String?
  device_id  String?

  request_id String? // trace request
  status     String? // SUCCESS / FAIL
  error      String?

  created_at DateTime @default(now())

  user User? @relation("UserToSystemLog", fields: [user_id], references: [id])

  @@index([user_id])
  @@index([entity, entity_id])
  @@index([created_at])
  @@map("system_log")
}

model RequestLog {
  id          String  @id @default(uuid())
  user_id     String?
  method      String
  path        String
  status_code Int
  duration_ms Int

  ip_address String?
  user_agent String?
  device_id  String?

  request_body  Json?
  response_body Json?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([created_at])
  @@map("request_log")
}

model AuthLog {
  id         String @id @default(uuid())
  account_id String
  action     String // LOGIN, LOGOUT, REFRESH
  status     String // SUCCESS / FAIL

  ip_address String?
  user_agent String?
  device_id  String?

  created_at DateTime @default(now())

  @@index([account_id])
  @@map("auth_log")
}
