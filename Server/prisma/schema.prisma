generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, vector]
}

model Account {
  id                  String               @id @default(uuid())
  type                AccountType
  username            String               @unique
  password            String?
  email               String?              @unique
  status              AccountStatus        @default(PENDING_ACTIVATION)
  created_at          DateTime             @default(now())
  activationTokens    ActivationToken[]
  devices             Device[]
  passwordResetTokens PasswordResetToken[]
  refreshToken        RefreshToken[]
  subject             Subject?
  user                User?

  @@map("accounts")
}

model ActivationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  account_id String
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("activation_tokens")
}

model User {
  id         String      @id @default(uuid())
  account_id String      @unique
  full_name  String
  role       UserAccountRole @default(USER) // Default role is now USER
  status     Boolean     @default(true)
  avatar_id  String?     @unique
  created_at DateTime    @default(now())
  update_at  DateTime    @updatedAt
  alerts     Alert[]     @relation("ResolvedAlerts")
  subject    Subject[]   @relation("UserToSubject")
  auditLogs  SystemLog[] @relation("UserToSystemLog")
  account    Account     @relation(fields: [account_id], references: [id])
  avatar     Image?      @relation("UserToAvatar", fields: [avatar_id], references: [id])
  zone       Zone[]      @relation("UserToZone")

  @@map("users")
}

model Subject {
  id               String        @id @default(uuid())
  account_id       String        @unique
  code             String        @unique @default(uuid())
  full_name        String
  dob              DateTime?
  gender           String?
  id_number        String?
  address          String?
  phone            String?
  status           SubjectStatus @default(INACTIVE)
  monitoring_start DateTime?
  monitoring_end   DateTime?
  avatar_id        String?       @unique
  created_by       String
  created_at       DateTime      @default(now())
  update_at        DateTime      @updatedAt
  deleted_at       DateTime?
  alert            Alert[]       @relation("SubjectToAlert")
  checkins         Checkin[]     @relation("SubjectToCheckin")
  events           EventLog[]    @relation("SubjectToEventLog")
  faceData         FaceData[]    @relation("SubjectToFaceData")
  subjectZone      SubjectZone[] @relation("SubjectToSubjectZone")
  account          Account       @relation(fields: [account_id], references: [id])
  avatar           Image?        @relation("SubjectToAvatar", fields: [avatar_id], references: [id])
  creator          User          @relation("UserToSubject", fields: [created_by], references: [id])

  @@index([full_name])
  @@index([status])
  @@index([created_by])
  @@map("subjects")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_hash String   @unique
  account_id String
  device_id  String
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("refreshtokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  account_id String
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Device {
  id           String    @id @default(uuid())
  account_id   String
  device_token String?
  device_uuid  String
  platform     String
  app_version  String?
  is_active    Boolean   @default(true)
  is_trusted   Boolean   @default(true)
  last_seen_at DateTime?
  created_at   DateTime  @default(now())
  account      Account   @relation(fields: [account_id], references: [id])

  @@unique([account_id, device_uuid])
  @@map("devices")
}

model FaceData {
  id         String                @id @default(uuid())
  subject_id String
  embedding  Unsupported("vector")
  created_at DateTime              @default(now())
  update_at  DateTime              @updatedAt
  subject    Subject               @relation("SubjectToFaceData", fields: [subject_id], references: [id], onDelete: Cascade)

  @@map("face_data")
}

model Zone {
  id          String                   @id @default(uuid())
  zone_name   String
  geom        Unsupported("geography(Polygon, 4326)")
  description String?
  created_by  String
  is_active   Boolean                  @default(true)
  created_at  DateTime                 @default(now())
  update_at   DateTime                 @updatedAt
  subjectZone SubjectZone[]            @relation("ZoneToSubjectZone")
  creator     User                     @relation("UserToZone", fields: [created_by], references: [id])

  @@index([geom], type: Gist)
  @@map("zones")
}

model SubjectZone {
  subject_id       String
  zone_id          String
  interval_minutes Int      @default(15)
  created_at       DateTime @default(now())
  subject          Subject  @relation("SubjectToSubjectZone", fields: [subject_id], references: [id], onDelete: Cascade)
  zone             Zone     @relation("ZoneToSubjectZone", fields: [zone_id], references: [id], onDelete: Cascade)

  @@id([subject_id, zone_id])
  @@map("subject_zones")
}

model Checkin {
  id            String                         @id @default(uuid())
  subject_id    String
  location      Unsupported("geography(Point, 4326)")
  notes         String?
  image_id      String?                        @unique
  device_id     String?
  face_verified Boolean                        @default(false)
  confidence    Float?
  status        String                         @default("ON_TIME") // Consider an enum for this
  checkin_time  DateTime                       @default(now())

  image         Image?                         @relation("CheckinToImage", fields: [image_id], references: [id], onDelete: SetNull)
  subject       Subject                        @relation("SubjectToCheckin", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([location], type: Gist)
  @@index([subject_id, checkin_time])
  @@map("checkins")
}

model Alert {
  id          String                    @id @default(uuid())
  subject_id  String
  type        String
  severity    Int
  message     String
  location    Unsupported("geography(Point, 4326)")?
  status      String                    @default("PENDING")
  resolved_by String?
  resolved_at DateTime?
  created_at  DateTime                  @default(now())
  resolver    User?                     @relation("ResolvedAlerts", fields: [resolved_by], references: [id])
  subject     Subject                   @relation("SubjectToAlert", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([location], type: Gist)
  @@index([subject_id, status])
  @@index([created_at(sort: Desc)])
  @@map("alerts")
}

model EventLog {
  id          String   @id @default(uuid())
  subject_id  String
  event_type  String
  description String
  created_at  DateTime @default(now())
  subject     Subject  @relation("SubjectToEventLog", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([subject_id, created_at])
  @@map("event_logs")
}

model SystemLog {
  id         String    @id @default(uuid())
  user_id    String?
  action     String
  entity     String?
  entity_id  String?
  old_data   Json?
  new_data   Json?
  ip_address String?
  user_agent String?
  device_id  String?
  request_id String?
  status     String?
  error      String?
  created_at DateTime  @default(now())
  user       User?     @relation("UserToSystemLog", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity, entity_id])
  @@index([created_at])
  @@map("system_log")
}

model RequestLog {
  id            String   @id @default(uuid())
  user_id       String?
  method        String
  path          String
  status_code   Int
  duration_ms   Int
  ip_address    String?
  user_agent    String?
  device_id     String?
  request_body  Json?
  response_body Json?
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([created_at])
  @@map("request_log")
}

model Image {
  id            String   @id @default(uuid())

  file_name     String
  stored_name   String
  mime_type     String
  size          Int
  url           String
  alt_text      String?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  checkinImage  Checkin? @relation("CheckinToImage")
  subjectAvatar Subject? @relation("SubjectToAvatar")
  userAvatar    User?    @relation("UserToAvatar")

  @@map("images")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum AccountType {
  USER
  SUBJECT
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

// Simplified user roles
enum UserAccountRole {
  ADMIN // Can do everything
  USER  // Can manage subjects and related entities
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}
