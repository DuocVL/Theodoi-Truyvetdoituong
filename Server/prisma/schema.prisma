generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Account {
  id                  String               @id @default(uuid())
  type                AccountType
  username            String               @unique
  password            String?
  email               String?              @unique
  status              AccountStatus        @default(PENDING_ACTIVATION)
  created_at          DateTime             @default(now())
  activationTokens    ActivationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshToken        RefreshToken[]
  subject             Subject?
  user                User?

  @@map("accounts")
}

model ActivationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  account_id String
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("activation_tokens")
}

model User {
  id         String          @id @default(uuid())
  account_id String          @unique
  full_name  String
  role       UserAccountRole @default(USER) // Default role is now USER
  status     Boolean         @default(true)
  avatar_id  String?         @unique
  created_at DateTime        @default(now())
  update_at  DateTime        @updatedAt

  subject    Subject[]   @relation("UserToSubject")
  systemLogs SystemLog[] @relation("UserToSystemLog")
  account    Account     @relation(fields: [account_id], references: [id])
  avatar     Image?      @relation("UserToAvatar", fields: [avatar_id], references: [id])
  zone       Zone[]      @relation("UserToZone")

  @@map("users")
}

model Subject {
  id         String        @id @default(uuid())
  account_id String        @unique
  full_name  String
  dob        DateTime?
  gender     String?
  id_number  String?
  address    String?
  phone      String?
  status     SubjectStatus @default(INACTIVE)

  monitoring_start DateTime? //thời gian bắt đầu cảnh báo
  monitoring_end   DateTime? //thời gian kết thúc cản báo
  avatar_id        String?   @unique
  created_by       String
  created_at       DateTime  @default(now())
  update_at        DateTime  @updatedAt
  deleted_at       DateTime?

  interval_minutes  Int       @default(30) // dùng khi KHÔNG thuộc zone nào
  grace_minutes     Int       @default(5) // NEW - thời gian chờ thêm sau khi nhắc
  last_checkin_at   DateTime? //lần checkin hợp lệ gần nhất (bất kể trong/ngoài zone)
  last_reminder_at  DateTime? //lần gửi nhắc 
  last_alert_at     DateTime? //lần tạo Alert gần nhất
  current_zone_id   String? //zone SAFE đang là nơi tính hạn, null = đang dùng default
  active_start_time String  @default("07:00")// "06:00" - bắt đầu khung giờ phải checkin, null = áp dụng 24/7
  active_end_time   String @default("17:00") // "22:00" - kết thúc khung giờ

  fcm_token String?

  checkins  Checkin[]         @relation("SubjectToCheckin")
  systemLog SystemLog[]       @relation("SubjectToSystemLog")
  faceData  FaceData[]        @relation("SubjectToFaceData")
  zones     Zone[]            @relation("SubjectToZones")
  locations LocationHistory[]

  account     Account @relation(fields: [account_id], references: [id])
  avatar      Image?  @relation("SubjectToAvatar", fields: [avatar_id], references: [id])
  creator     User    @relation("UserToSubject", fields: [created_by], references: [id])
  currentZone Zone?   @relation("SubjectCurrentZone", fields: [current_zone_id], references: [id], onDelete: SetNull)

  alertSubject Alert[] @relation("SubjectToAlert")

  @@index([full_name])
  @@index([status])
  @@index([created_by])
  @@map("subjects")
}

enum ZoneType {
  SAFE // Vùng an toàn/chỉ định (Đối tượng KHÔNG ĐƯỢC rời khỏi)
  RESTRICTED // Vùng cấm/hạn chế (Đối tượng KHÔNG ĐƯỢC đi vào)
}

model Zone {
  id               String   @id @default(uuid())
  subject_id       String // Khóa ngoại liên kết trực tiếp tới Đối tượng
  zone_name        String
  type             ZoneType @default(SAFE)
  latitude         Float
  longitude        Float
  radius           Float
  interval_minutes Int      @default(15) // Thời gian giãn cách yêu cầu checkin (phút)
  grace_minutes    Int      @default(5) // thời gian chờ thêm sau khi nhắc, trước khi tạo Alert
  description      String?
  created_by       String // ID của User (Cán bộ) tạo vùng này
  is_active        Boolean  @default(true)

  active_start_time String? // "06:00" - khung giwof trong zone này
  active_end_time   String? // "22:00" - khung giwof két thúc

  created_at DateTime @default(now())
  update_at  DateTime @updatedAt

  subject         Subject   @relation("SubjectToZones", fields: [subject_id], references: [id], onDelete: Cascade)
  creator         User      @relation("UserToZone", fields: [created_by], references: [id])
  subjectsCurrent Subject[] @relation("SubjectCurrentZone")

  alertZone Alert[]   @relation("ZoneToAlert")
  checkins  Checkin[] @relation("ZoneToCheckin")

  @@map("zones")
}

model LocationHistory {
  id String @id @default(uuid())
  subject_id String

  latitude  Float
  longitude Float

  //các thông số chưa được sử dụng 
  accuracy  Float? //độ chính xác
  speed     Float? //tốc độ
  altitude  Float? //độ cao

  recorded_at DateTime @default(now())
  created_at  DateTime @default(now())

  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  // query theo đối tượng + thời gian
  @@index([subject_id, recorded_at(sort: Desc)])
  // dọn dữ liệu / thống kê theo ngày
  @@index([recorded_at])
  @@map("location_histories")
}

enum AlertType {
  RESTRICTED_ENTRY // checkin/vị trí rơi vào vùng cấm
  MISSED_CHECKIN // quá hạn checkin ở vùng an toàn, đã nhắc nhưng không checkin
}

model Alert {
  id         String    @id @default(uuid())
  subject_id String
  zone_id    String?
  checkin_id String? // liên kết checkin gây ra alert, nếu có
  type       AlertType
  message    String?
  created_at DateTime  @default(now())

  subject Subject  @relation("SubjectToAlert", fields: [subject_id], references: [id], onDelete: Cascade)
  zone    Zone?    @relation("ZoneToAlert", fields: [zone_id], references: [id], onDelete: SetNull)
  checkin Checkin? @relation("CheckinToAlert", fields: [checkin_id], references: [id], onDelete: SetNull)

  @@index([subject_id, created_at])
  @@map("alerts")
}

enum CheckinStatus {
  ON_TIME // checkin trong hạn cho phép, không vi phạm zone cấm
  LATE // checkin trễ (sau dueAt) nhưng subject tự chủ động checkin trước khi bị tạo Alert
  RESTRICTED_VIOLATION // checkin rơi vào zone cấm
}

model Checkin {
  id            String  @id @default(uuid())
  subject_id    String
  notes         String?
  image_id      String? @unique
  face_verified Boolean @default(false)

  latitude     Float
  longitude    Float
  status       CheckinStatus @default(ON_TIME)
  checkin_time DateTime      @default(now())
  zone_id      String?
  zone         Zone?         @relation("ZoneToCheckin", fields: [zone_id], references: [id], onDelete: SetNull)

  image        Image?  @relation("CheckinToImage", fields: [image_id], references: [id], onDelete: SetNull)
  subject      Subject @relation("SubjectToCheckin", fields: [subject_id], references: [id], onDelete: Cascade)
  alertCheckin Alert[] @relation("CheckinToAlert")

  @@index([subject_id, checkin_time])
  @@map("checkins")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token_hash String   @unique
  account_id String
  device_id  String
  revoked    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("refreshtokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  account_id String
  expires_at DateTime
  created_at DateTime @default(now())
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model FaceData {
  id         String                @id @default(uuid())
  subject_id String                @unique
  embedding  Unsupported("vector")
  created_at DateTime              @default(now())
  update_at  DateTime              @updatedAt
  subject    Subject               @relation("SubjectToFaceData", fields: [subject_id], references: [id], onDelete: Cascade)

  @@map("face_data")
}

model SystemLog {
  id         String  @id @default(uuid())
  user_id    String?
  subject_id String? // Đối tượng bị tác động (THÊM MỚI để truy vết đối tượng)

  // Phân loại log để dễ lọc: 
  // 'SYSTEM' (đăng nhập, lỗi), 'SUBJECT_ACTIVITY' (checkin, di chuyển), 'AUDIT' (cán bộ sửa hồ sơ)
  category String @default("SYSTEM")
  action   String // Hành động cụ thể: "CHECKIN", "ZONE_VIOLATION", "PROFILE_UPDATE"

  entity    String?
  entity_id String?

  old_data Json?
  new_data Json?

  ip_address  String?
  user_agent  String?
  duration_ms Int?
  status_code Int?

  created_at DateTime @default(now())

  user    User?    @relation("UserToSystemLog", fields: [user_id], references: [id], onDelete: Cascade)
  subject Subject? @relation("SubjectToSystemLog", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([category, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([subject_id, created_at(sort: Desc)])
  @@map("systemlog")
}

model Image {
  id String @id @default(uuid())

  file_name   String
  stored_name String
  mime_type   String
  size        Int
  url         String
  alt_text    String?

  created_at DateTime @default(now())

  checkinImage  Checkin? @relation("CheckinToImage")
  subjectAvatar Subject? @relation("SubjectToAvatar")
  userAvatar    User?    @relation("UserToAvatar")

  @@map("images")
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum AccountType {
  USER
  SUBJECT
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

// Simplified user roles
enum UserAccountRole {
  ADMIN // Can do everything
  USER // Can manage subjects and related entities
}

enum SubjectStatus {
  ACTIVE
  NO_FACE
  INACTIVE
  COMPLETED
}
