
# ================================================
# ENVIRONMENT VARIABLES FOR FACE SERVICE
# ================================================

# --- Anti-Spoofing Configuration ---
# Sets the strictness of the anti-spoofing model.
# Options: "relaxed", "balanced", "strict"
# Default: "balanced"
ANTI_SPOOF_LEVEL=balanced

# --- Device Configuration ---
# These variables control whether the models run on CPU or GPU.
# For GPU, you need a compatible NVIDIA GPU with CUDA installed.

# For the main face detection/embedding model (InsightFace)
# -1 = CPU
#  0 = GPU 0
#  1 = GPU 1, etc.
INSIGHTFACE_CTX_ID=-1

# For the anti-spoofing model (PyTorch)
# "cpu" or "cuda"
TORCH_DEVICE=cpu

